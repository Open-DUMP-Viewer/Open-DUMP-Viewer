+/* Fit DECIMAL(p,s) (p>=1) within a DBMS's maximum precision / scale */
+static void fit_decimal(int *p, int *s, int maxp, int maxs, int *clamped)
+{
+    *clamped = 0;
+    if (*s > maxs) { *s = maxs; *clamped = 1; }
+    if (*p > maxp) { *p = maxp; *clamped = 1; }
+    if (*s > *p) { *s = *p; *clamped = 1; }
+}
