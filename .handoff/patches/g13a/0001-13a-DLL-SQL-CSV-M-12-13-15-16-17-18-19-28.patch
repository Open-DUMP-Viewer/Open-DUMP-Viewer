+        ctx->cvt_cap = need;
+    }
+    if (convert_charset(src, (int)n, s->dump_charset, ctx->cvt, (int)ctx->cvt_cap,
+                        s->out_charset, &out_len) != ODV_OK || out_len < 0 ||
+        (size_t)out_len >= ctx->cvt_cap)
+        return src;
+    ctx->cvt[out_len] = '\0';
