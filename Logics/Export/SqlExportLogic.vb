Imports System.IO
Imports System.Text

''' <summary>
''' SQL INSERT 文エクスポートロジック
'''
''' 2つのエクスポート経路を提供:
''' 1. C DLL 経由 (Workspace): DUMP ファイルを再パースしながらストリーミング出力
''' 2. VB.NET インメモリ (TablePreview): フィルタ後データを StreamWriter で逐次書き出し
'''
''' 対応 DBMS: Oracle, PostgreSQL, MySQL, SQL Server
''' </summary>
Public Class SqlExportLogic

    ''' <summary>
    ''' C DLL 経由で SQL エクスポート (全行・ストリーミング)
    ''' </summary>
    Public Shared Function ExportFromDump(ctx As ExportHelper.TableExportContext, outputPath As String, dbmsType As Integer,
                                          Optional worker As System.ComponentModel.BackgroundWorker = Nothing) As Boolean
        Dim progressAction As Action(Of Long, String, Integer) = Nothing
        If worker IsNot Nothing Then
            progressAction = Sub(rows As Long, tbl As String, pct As Integer)
                                 worker.ReportProgress(0,
                                     New ExportProgressDialog.ProgressInfo(tbl, rows, ctx.RowCount))
                             End Sub
        End If

        Dim rc = Open_NativeParser.ExportSql(ctx.DumpFilePath, ctx.TableName, outputPath, dbmsType,
                                               ctx.Schema, ctx.DataOffset, progressAction, ctx.Partition)
        If rc <> Open_NativeParser.ODV_OK Then
            Throw New Exception(Loc.SF("SqlExport_ErrorRc", rc))
        End If
        Return True
    End Function

    ''' <summary>
    ''' VB.NET インメモリデータから SQL INSERT 文を生成
    ''' BackgroundWorker から呼び出して進捗報告可能
    ''' </summary>
    Public Shared Function ExportFromData(data As List(Of String()),
                                          columnNames As List(Of String),
                                          columnTypes As String(),
                                          schema As String,
                                          tableName As String,
                                          outputPath As String,
                                          dbmsType As Integer,
                                          Optional worker As System.ComponentModel.BackgroundWorker = Nothing,
                                          Optional columnNotNulls As Boolean() = Nothing,
                                          Optional columnDefaults As String() = Nothing,
                                          Optional databaseName As String = Nothing,
                                          Optional constraintsJson As String = Nothing) As Boolean
        Try
            Dim totalRows As Long = data.Count
            Dim isSqlServer = (dbmsType = ExportHelper.DBMS_SQLSERVER)

            ' SQL Server: スキーマを dbo に変換
            If isSqlServer AndAlso Not String.IsNullOrEmpty(schema) Then
                schema = "dbo"
            End If

            Using sw As New StreamWriter(outputPath, False, New UTF8Encoding(False))
                ' USE [DB] (SQL Server のみ、DB名が指定されている場合)
                If isSqlServer AndAlso Not String.IsNullOrEmpty(databaseName) Then
                    sw.WriteLine($"USE [{databaseName}]")
                    sw.WriteLine("GO")
                    sw.WriteLine()
                End If

                ' Oracle: SQL*Plus 向けの設定 (& 置換の抑止・空行許可)。C 経路 (write_sql_file)
                ' と同じく、& や改行を含む値が流れても壊れないようにする (H-20)
                If dbmsType = ExportHelper.DBMS_ORACLE Then
                    sw.WriteLine("SET DEFINE OFF")
                    sw.WriteLine("SET SQLBLANKLINES ON")
                    sw.WriteLine()
                End If

                ' ヘッダコメント
                sw.WriteLine($"-- Table: {schema}.{tableName}")
                sw.WriteLine("-- Generated by Open DUMP Viewer for Oracle database")
                sw.WriteLine()

                ' ダンプに完全な形で入っていなかった DDL (exp が切った DEFAULT など) の注記
                WriteParserNotes(sw, constraintsJson)

                ' 裸 NUMBER → INTEGER 推定 (オプション)
                Dim effectiveTypes = columnTypes
                If ExportOptions.SqlInferInteger AndAlso columnTypes IsNot Nothing Then
                    effectiveTypes = ExportHelper.InferIntegerTypes(columnTypes, data, columnDefaults)
                End If

                ' CREATE TABLE DDL (オプション)
                If ExportOptions.SqlCreateTable AndAlso effectiveTypes IsNot Nothing Then
                    ' DROP TABLE IF EXISTS
                    WriteDropTable(sw, schema, tableName, dbmsType)

                    WriteCreateTable(sw, schema, tableName, columnNames, effectiveTypes, dbmsType,
                                     columnNotNulls, columnDefaults)
                    sw.WriteLine()
                End If

                ' CREATE INDEX / 制約 DDL (オプション)
                If ExportOptions.SqlCreateIndex AndAlso
                   Not String.IsNullOrEmpty(constraintsJson) AndAlso constraintsJson <> "[]" Then
                    WriteConstraints(sw, schema, tableName, constraintsJson, dbmsType)
                    sw.WriteLine()
                End If

                ' GO (SQL Server のみ)
                If isSqlServer AndAlso (ExportOptions.SqlCreateTable OrElse ExportOptions.SqlCreateIndex) Then
                    sw.WriteLine("GO")
                    sw.WriteLine()
                End If

                ' INSERT INTO データ出力 (オプション)
                If Not ExportOptions.SqlWriteInserts Then
                    Return True
                End If

                ' INSERT INTO ... (...) VALUES ( プレフィックスをキャッシュ
                Dim prefix = BuildInsertPrefix(schema, tableName, columnNames, dbmsType)

                ' データ行 (1行ずつストリーミング書き出し)
                For rowIdx As Long = 0 To totalRows - 1
                    If worker IsNot Nothing AndAlso worker.CancellationPending Then
                        Return False
                    End If

                    Dim row = data(CInt(rowIdx))
                    sw.Write(prefix)

                    For colIdx As Integer = 0 To columnNames.Count - 1
                        If colIdx > 0 Then sw.Write(", ")

                        Dim value As String = Nothing
                        If colIdx < row.Length Then value = row(colIdx)

                        ' 数値型の列のみ引用符なし。文字列型は数字に見えても常に引用符付き (H-08)
                        Dim isNumCol = (columnTypes IsNot Nothing AndAlso colIdx < columnTypes.Length AndAlso
                                        ExportHelper.IsNumericColumnType(columnTypes(colIdx)))

                        If String.IsNullOrEmpty(value) Then
                            sw.Write("NULL")
                        ElseIf isNumCol AndAlso ExportHelper.IsNumericValue(value) Then
                            sw.Write(value)
                        Else
                            sw.Write(ExportHelper.EscapeSqlString(value, dbmsType))
                        End If
                    Next

                    sw.WriteLine(");")

                    ' 進捗報告 (1000行ごと)
                    If worker IsNot Nothing AndAlso (rowIdx Mod 1000 = 0 OrElse rowIdx = totalRows - 1) Then
                        Dim pct As Integer = CInt(If(totalRows > 0, (rowIdx + 1) * 100 \ totalRows, 100))
                        worker.ReportProgress(pct,
                            New ExportProgressDialog.ProgressInfo($"{schema}.{tableName}", rowIdx + 1, totalRows))
                    End If
                Next

                ' GO (SQL Server のみ)
                If isSqlServer AndAlso totalRows > 0 Then
                    sw.WriteLine("GO")
                End If
            End Using

            Return True

        Catch ex As Exception
            Throw New Exception(Loc.SF("SqlExport_Error", ex.Message), ex)
        End Try
    End Function

    ''' <summary>
    ''' DROP TABLE IF EXISTS を出力
    ''' </summary>
    Private Shared Sub WriteDropTable(sw As StreamWriter, schema As String, tableName As String, dbmsType As Integer)
        Dim fullName As String
        If Not String.IsNullOrEmpty(schema) Then
            fullName = ExportHelper.EscapeSqlIdentifier(schema, dbmsType) & "." & ExportHelper.EscapeSqlIdentifier(tableName, dbmsType)
        Else
            fullName = ExportHelper.EscapeSqlIdentifier(tableName, dbmsType)
        End If

        Select Case dbmsType
            Case ExportHelper.DBMS_MYSQL
                sw.WriteLine($"DROP TABLE IF EXISTS {fullName};")
            Case ExportHelper.DBMS_SQLSERVER
                sw.WriteLine($"DROP TABLE IF EXISTS {fullName};")
                sw.WriteLine("GO")
            Case ExportHelper.DBMS_POSTGRES
                sw.WriteLine($"DROP TABLE IF EXISTS {fullName};")
            Case Else ' Oracle
                sw.WriteLine("BEGIN")
                sw.WriteLine($"    EXECUTE IMMEDIATE 'DROP TABLE {fullName.Replace("'", "''")}';")
                sw.WriteLine("EXCEPTION WHEN OTHERS THEN NULL;")
                sw.WriteLine("END;")
                sw.WriteLine("/")
        End Select
        sw.WriteLine()
    End Sub

    ''' <summary>
    ''' CREATE TABLE DDL を出力 (NOT NULL / DEFAULT 対応)
    ''' </summary>
    Private Shared Sub WriteCreateTable(sw As StreamWriter, schema As String, tableName As String,
                                         columnNames As List(Of String), columnTypes As String(),
                                         dbmsType As Integer,
                                         Optional columnNotNulls As Boolean() = Nothing,
                                         Optional columnDefaults As String() = Nothing)
        Dim sb As New StringBuilder("CREATE TABLE ")

        If Not String.IsNullOrEmpty(schema) Then
            sb.Append(ExportHelper.EscapeSqlIdentifier(schema, dbmsType))
            sb.Append("."c)
        End If
        sb.Append(ExportHelper.EscapeSqlIdentifier(tableName, dbmsType))
        sb.AppendLine(" (")

        For i As Integer = 0 To columnNames.Count - 1
            If i > 0 Then sb.AppendLine(",")
            sb.Append("    ")
            sb.Append(ExportHelper.EscapeSqlIdentifier(columnNames(i), dbmsType))
            sb.Append(" ")
            If i < columnTypes.Length Then
                sb.Append(ExportHelper.MapOracleType(columnTypes(i), dbmsType))
            Else
                sb.Append("VARCHAR(4000)")
            End If

            ' NOT NULL
            If columnNotNulls IsNot Nothing AndAlso i < columnNotNulls.Length AndAlso columnNotNulls(i) Then
                sb.Append(" NOT NULL")
            End If

            ' DEFAULT (sanitize to prevent SQL injection from malicious dump files)
            If columnDefaults IsNot Nothing AndAlso i < columnDefaults.Length AndAlso
               Not String.IsNullOrEmpty(columnDefaults(i)) Then
                Dim defaultVal = columnDefaults(i).Trim().TrimEnd(";"c)
                If Not String.IsNullOrWhiteSpace(defaultVal) Then
                    sb.Append($" DEFAULT {defaultVal}")
                End If
            End If
        Next

        sb.AppendLine()

        ' ON [PRIMARY] (SQL Server のみ)
        If dbmsType = ExportHelper.DBMS_SQLSERVER Then
            sb.AppendLine(") ON [PRIMARY];")
        Else
            sb.AppendLine(");")
        End If

        sw.Write(sb.ToString())
    End Sub

    ''' <summary>
    ''' INSERT INTO "schema"."table" ("col1", "col2") VALUES ( プレフィックスを構築
    ''' </summary>
    Private Shared Function BuildInsertPrefix(schema As String, tableName As String,
                                               columnNames As List(Of String), dbmsType As Integer) As String
        Dim sb As New StringBuilder("INSERT INTO ")

        If Not String.IsNullOrEmpty(schema) Then
            sb.Append(ExportHelper.EscapeSqlIdentifier(schema, dbmsType))
            sb.Append("."c)
        End If
        sb.Append(ExportHelper.EscapeSqlIdentifier(tableName, dbmsType))

        sb.Append(" (")
        For i As Integer = 0 To columnNames.Count - 1
            If i > 0 Then sb.Append(", ")
            sb.Append(ExportHelper.EscapeSqlIdentifier(columnNames(i), dbmsType))
        Next
        sb.Append(") VALUES (")

        Return sb.ToString()
    End Function

    ''' <summary>
    ''' 制約 DDL を出力 (JSON からデシリアライズして ALTER TABLE 文を生成)
    ''' </summary>
    Private Shared Sub WriteConstraints(sw As StreamWriter, schema As String, tableName As String,
                                         constraintsJson As String, dbmsType As Integer)
        Try
            Dim constraints = Text.Json.JsonSerializer.Deserialize(Of List(Of ConstraintInfo))(constraintsJson)
            If constraints Is Nothing OrElse constraints.Count = 0 Then Return

            Dim fullName As String
            If Not String.IsNullOrEmpty(schema) Then
                fullName = ExportHelper.EscapeSqlIdentifier(schema, dbmsType) & "." & ExportHelper.EscapeSqlIdentifier(tableName, dbmsType)
            Else
                fullName = ExportHelper.EscapeSqlIdentifier(tableName, dbmsType)
            End If

            For Each c In constraints
                ' コメント (type=5) と注記 (type=6) には columns が無い。Nothing のまま Select すると
                ' 例外になり、下の Catch で以降が黙って捨てられていた (コメントが一度も出力されなかった)
                Dim colList = String.Join(", ", If(c.columns, Array.Empty(Of String)()).Select(Function(col) ExportHelper.EscapeSqlIdentifier(col, dbmsType)))

                Select Case c.type
                    Case 0 ' PRIMARY KEY
                        If Not String.IsNullOrEmpty(c.name) Then
                            sw.WriteLine($"ALTER TABLE {fullName} ADD CONSTRAINT {ExportHelper.EscapeSqlIdentifier(c.name, dbmsType)} PRIMARY KEY ({colList});")
                        Else
                            sw.WriteLine($"ALTER TABLE {fullName} ADD PRIMARY KEY ({colList});")
                        End If

                    Case 1 ' UNIQUE
                        If Not String.IsNullOrEmpty(c.name) Then
                            sw.WriteLine($"ALTER TABLE {fullName} ADD CONSTRAINT {ExportHelper.EscapeSqlIdentifier(c.name, dbmsType)} UNIQUE ({colList});")
                        Else
                            sw.WriteLine($"ALTER TABLE {fullName} ADD UNIQUE ({colList});")
                        End If

                    Case 2 ' FOREIGN KEY
                        Dim refName As String
                        If Not String.IsNullOrEmpty(c.ref_schema) Then
                            refName = ExportHelper.EscapeSqlIdentifier(c.ref_schema, dbmsType) & "." & ExportHelper.EscapeSqlIdentifier(c.ref_table, dbmsType)
                        Else
                            refName = ExportHelper.EscapeSqlIdentifier(If(c.ref_table, ""), dbmsType)
                        End If
                        Dim refColList = String.Join(", ", If(c.ref_columns, {}).Select(Function(col) ExportHelper.EscapeSqlIdentifier(col, dbmsType)))

                        If Not String.IsNullOrEmpty(c.name) Then
                            sw.WriteLine($"ALTER TABLE {fullName} ADD CONSTRAINT {ExportHelper.EscapeSqlIdentifier(c.name, dbmsType)} FOREIGN KEY ({colList}) REFERENCES {refName} ({refColList});")
                        Else
                            sw.WriteLine($"ALTER TABLE {fullName} ADD FOREIGN KEY ({colList}) REFERENCES {refName} ({refColList});")
                        End If

                    Case 3 ' CHECK
                        Dim cond = If(c.condition, "")
                        If Not String.IsNullOrEmpty(c.name) Then
                            sw.WriteLine($"ALTER TABLE {fullName} ADD CONSTRAINT {ExportHelper.EscapeSqlIdentifier(c.name, dbmsType)} CHECK {cond};")
                        Else
                            sw.WriteLine($"ALTER TABLE {fullName} ADD CHECK {cond};")
                        End If

                    Case 4 ' INDEX
                        Dim idxName = If(c.name, "")
                        Dim indexExpr = If(c.index_expr, "")
                        Dim colExpr As String
                        If Not String.IsNullOrEmpty(indexExpr) Then
                            ' Use the full expression (handles function-based indexes)
                            colExpr = indexExpr
                        ElseIf c.columns IsNot Nothing AndAlso c.columns.Length > 0 Then
                            colExpr = "(" & String.Join(", ", c.columns.Select(Function(col) ExportHelper.EscapeSqlIdentifier(col, dbmsType))) & ")"
                        Else
                            colExpr = "()"
                        End If
                        Dim nameClause = If(Not String.IsNullOrEmpty(idxName), " " & ExportHelper.EscapeSqlIdentifier(idxName, dbmsType), "")
                        sw.WriteLine($"CREATE INDEX{nameClause} ON {fullName} {colExpr};")

                    Case 5 ' COMMENT
                        Dim tblComment = If(c.table_comment, "")
                        Dim colComments = c.col_comments

                        ' Table comment
                        If Not String.IsNullOrEmpty(tblComment) Then
                            Select Case dbmsType
                                Case ExportHelper.DBMS_MYSQL
                                    sw.WriteLine($"ALTER TABLE {fullName} COMMENT = {ExportHelper.EscapeSqlString(tblComment, dbmsType)};")
                                Case ExportHelper.DBMS_SQLSERVER
                                    sw.WriteLine($"-- COMMENT ON TABLE {tableName}: {CommentLineText(tblComment, dbmsType)}")
                                Case ExportHelper.DBMS_ORACLE
                                    WriteOracleComment(sw, $"TABLE {fullName}", tblComment)
                                Case Else ' PostgreSQL
                                    sw.WriteLine($"COMMENT ON TABLE {fullName} IS {ExportHelper.EscapeSqlString(tblComment, dbmsType)};")
                            End Select
                        End If

                        ' Column comments
                        If colComments IsNot Nothing Then
                            For Each kvp In colComments
                                Select Case dbmsType
                                    Case ExportHelper.DBMS_MYSQL, ExportHelper.DBMS_SQLSERVER
                                        sw.WriteLine($"-- COMMENT ON COLUMN {tableName}.{kvp.Key}: {CommentLineText(kvp.Value, dbmsType)}")
                                    Case ExportHelper.DBMS_ORACLE
                                        WriteOracleComment(sw, $"COLUMN {fullName}.{ExportHelper.EscapeSqlIdentifier(kvp.Key, dbmsType)}", kvp.Value)
                                    Case Else ' PostgreSQL
                                        sw.WriteLine($"COMMENT ON COLUMN {fullName}.{ExportHelper.EscapeSqlIdentifier(kvp.Key, dbmsType)} IS {ExportHelper.EscapeSqlString(kvp.Value, dbmsType)};")
                                End Select
                            Next
                        End If
                End Select
            Next
        Catch
            ' JSON パースエラーは無視
        End Try
    End Sub

    ''' <summary>
    ''' 解析エンジンが残した注記 (constraints_json の type=6) を "-- NOTE:" 行で出力する。
    ''' ダンプに完全な形で入っていなかった DDL は使わずに捨てるため、捨てたことを出力に残す。
    ''' </summary>
    Private Shared Sub WriteParserNotes(sw As StreamWriter, constraintsJson As String)
        If String.IsNullOrEmpty(constraintsJson) OrElse constraintsJson = "[]" Then Return
        Try
            Dim items = Text.Json.JsonSerializer.Deserialize(Of List(Of ConstraintInfo))(constraintsJson)
            If items Is Nothing Then Return
            Dim written = False
            For Each c In items
                If c.type <> 6 OrElse c.notes Is Nothing Then Continue For
                For Each n In c.notes
                    sw.WriteLine("-- NOTE: " & If(n, "").Replace(vbCr, " ").Replace(vbLf, " "))
                    written = True
                Next
            Next
            If written Then sw.WriteLine()
        Catch
            ' JSON パースエラーは無視 (WriteConstraints と同じ)
        End Try
    End Sub

    ''' <summary>
    ''' Oracle の COMMENT ON 文を出力する。COMMENT ON ... IS は文字列リテラルしか受け付けないため、
    ''' 改行を CHR() の連結で書く EscapeSqlString (H-20) の形は ORA-00933 になる。exp のコメントは
    ''' 改行を保って読めるようになった (M-08) ので、改行を含むものは EXECUTE IMMEDIATE で発行し、
    ''' リテラルを PL/SQL 側で CHR() を使って組み立てる (SQL*Plus 向けに 1 行に収める)。
    ''' </summary>
    ''' <param name="target">"TABLE ""S"".""T""" または "COLUMN ""S"".""T"".""C"""</param>
    Private Shared Sub WriteOracleComment(sw As StreamWriter, target As String, text As String)
        If text.IndexOfAny({ControlChars.Cr, ControlChars.Lf}) < 0 Then
            sw.WriteLine($"COMMENT ON {target} IS {ExportHelper.EscapeSqlString(text, ExportHelper.DBMS_ORACLE)};")
            Return
        End If
        Dim sb As New StringBuilder("    EXECUTE IMMEDIATE 'COMMENT ON ")
        sb.Append(target.Replace("'", "''")).Append(" IS ''")
        For Each ch In text
            Select Case ch
                Case "'"c
                    sb.Append("''''")   ' 文中の '' を、さらに PL/SQL のリテラル用に二重化
                Case ControlChars.Cr, ControlChars.Lf
                    sb.Append($"' || CHR({AscW(ch)}) || '")
                Case Else
                    sb.Append(ch)
            End Select
        Next
        sb.Append("''';")
        sw.WriteLine("BEGIN")
        sw.WriteLine(sb.ToString())
        sw.WriteLine("END;")
        sw.WriteLine("/")
    End Sub

    ''' <summary>
    ''' "-- ..." の SQL コメント行に入れるコメント文字列。改行を含むコメントは、改行で "--" が終わって
    ''' 残りが SQL として読まれるため、続きの行にも "-- " を付ける。
    ''' </summary>
    Private Shared Function CommentLineText(text As String, dbmsType As Integer) As String
        Return ExportHelper.EscapeSqlString(text, dbmsType).
            Replace(vbCrLf, vbLf).Replace(vbCr, vbLf).
            Replace(vbLf, Environment.NewLine & "-- ")
    End Function

    ''' <summary>制約情報のデシリアライズ用クラス</summary>
    Private Class ConstraintInfo
        Public Property type As Integer
        Public Property name As String
        Public Property columns As String()
        Public Property ref_schema As String
        Public Property ref_table As String
        Public Property ref_columns As String()
        Public Property condition As String
        Public Property index_expr As String
        Public Property table_comment As String
        Public Property col_comments As Dictionary(Of String, String)
        Public Property notes As String()
    End Class

End Class
